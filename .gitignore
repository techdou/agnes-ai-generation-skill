# ============================================================
# agnes-ai-generation-skill — .gitignore
#
# 原则:
#   1. 敏感信息绝对不入库(API Key / 凭证 / 密钥)
#   2. 运行产物与缓存不入库(output/ / __pycache__ / 文档缓存)
#   3. 开发工具个人配置不入库(.zcode/ .vscode/ .claude/ 等)
#   4. 归档 / 备份 / 内部开发笔记不入库(避免开发状态泄漏)
#   5. skill 功能本体必须入库:SKILL.md / references/ / templates/ /
#      agents/openai.yaml(客户端接口元数据)不在此排除
# ============================================================

# ---------- 敏感信息(绝对不入库) ----------
.env
.env.*
*.key
*.pem
*credentials*
*secret*

# ---------- 运行产物 / 缓存 ----------
output/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/

# ---------- Python 虚拟环境 ----------
venv/
.venv/
env/
ENV/

# ---------- IDE / AI 编码助手个人配置 ----------
.vscode/
.idea/
.zcode/
.claude/
.cursor/
.continue/
.codeium/
.windsurf/
.trae/
.qoder/
.aider*
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------- 日志 / 测试产物 ----------
*.log
*.tmp
*.jsonl
.cache/
.pytest_cache/
htmlcov/
.coverage

# ---------- 归档 / 备份 / 内部笔记(避免开发状态泄漏) ----------
archive/
存档/
*归档*
*.bak
*.orig
*.backup
NOTES*.md

desktop.ini
ehthumbs.db

# ── 2026-10-27 统一范式补全（与 techdou 仓 .gitignore 标准对齐）──

# ── 私密信息与密钥：绝不入库 ──
*.p12
*.pfx
secrets*
credentials*
*.token
_htpasswd


# ── 开发软件配置目录：本地工具状态不上传 ──
.claude.json
.codex/
.gemini/
.roo/
continue/
.aws/
.ssh/


# ── 内部文档与开发状态：不入版本控制，避免泄漏 ──
# README.md / CHANGELOG.md / SKILL.md / references/ / evals/ 是仓库正式内容，保持跟踪
drafts/
notes/
private/
internal/
dev/
dev-notes/
.archive/
.research/
*.draft.md
*.local.md
*.wip.md
DEVLOG.md
TODO.md
STATUS.md


# ── Node 前端产物 ──
node_modules/
.next/
.nuxt/
*.tsbuildinfo
