# ============================================================
# agnes-ai-generation-skill — .gitignore
#
# 原则:
#   1. 敏感信息绝对不入库(API Key / 凭证 / 密钥)
#   2. 运行产物与缓存不入库(output/ / __pycache__ / 文档缓存)
#   3. 开发工具个人配置不入库(.zcode/ .vscode/ .claude/ 等)
#   4. skill 功能本体必须入库:SKILL.md / references/ / templates/ /
#      agents/openai.yaml(客户端接口元数据)不在此排除
# ============================================================

# ---------- 敏感信息(绝对不入库) ----------
.env
.env.*
*.key
*.pem
*credentials*
*secret*

# ---------- 运行产物 / 缓存 ----------
output/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/

# ---------- Python 虚拟环境 ----------
venv/
.venv/
env/
ENV/

# ---------- IDE / AI 编码助手个人配置 ----------
.vscode/
.idea/
.zcode/
.claude/
.cursor/
.continue/
.codeium/
.windsurf/
.trae/
.qoder/
.aider*
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------- 日志 / 测试产物 ----------
*.log
*.tmp
*.jsonl
.cache/
.pytest_cache/
htmlcov/
.coverage

desktop.ini
ehthumbs.db
